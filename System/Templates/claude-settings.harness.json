{
  "statusLine": {
    "type": "command",
    "command": "sh \"$HOME/Brain/System/scripts/statusline.sh\""
  },
  "hooks": {
    "SessionStart": [
      {
        "matcher": "startup|resume|clear|compact",
        "hooks": [
          { "type": "command", "command": "sh \"$HOME/Brain/System/scripts/session-context.sh\"" }
        ]
      }
    ],
    "UserPromptSubmit": [
      {
        "hooks": [
          { "type": "command", "command": "sh \"$HOME/Brain/System/scripts/usage-check.sh\"" }
        ]
      }
    ],
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          { "type": "command", "command": "sh \"$HOME/Brain/System/scripts/precommit-check.sh\"" }
        ]
      }
    ]
  },
  "permissions": {
    "additionalDirectories": ["__BRAIN__"]
  }
}
